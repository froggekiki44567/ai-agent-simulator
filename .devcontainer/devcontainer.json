{
  "name": "AgentTown",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "runServices": ["dev", "nats", "postgres"],
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "anthropic.claude-code", "openai.chatgpt"],
      "settings": { "editor.formatOnSave": true, "editor.tabSize": 4 }
    }
  },
  "postCreateCommand": "npm install -g @openai/codex && dotnet --info",
  "remoteUser": "vscode"
}
